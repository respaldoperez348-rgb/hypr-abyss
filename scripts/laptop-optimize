#!/usr/bin/env bash
set -e

echo -e "\033[1;36m==> [1/5] Limpiando papelera y cachés de usuario...\033[0m"
rm -rf ~/.local/share/Trash/* ~/.cache/thumbnails/* ~/.cache/paru/clone/* ~/.cache/yay/* 2>/dev/null || true
if command -v npm >/dev/null 2>&1; then
    npm cache clean --force 2>/dev/null || true
fi

echo -e "\033[1;36m==> [2/5] Purgando paquetes huérfanos sin uso...\033[0m"
orphans=$(pacman -Qtdq 2>/dev/null || true)
if [ -n "$orphans" ]; then
    echo "Eliminando huérfanos: $orphans"
    sudo pacman -Rns --noconfirm $orphans
else
    echo "No hay paquetes huérfanos."
fi

echo -e "\033[1;36m==> [3/5] Reduciendo caché de Pacman (conservando las 2 últimas versiones)...\033[0m"
if command -v paccache >/dev/null 2>&1; then
    sudo paccache -rk2
    sudo paccache -ruk0
else
    sudo pacman -Sc --noconfirm
fi

echo -e "\033[1;36m==> [4/5] Compactando logs antiguos de systemd journal a 3 días...\033[0m"
sudo journalctl --vacuum-time=3d --vacuum-size=50M

echo -e "\033[1;36m==> [5/5] Optimizando celdas del disco NVMe SSD (TRIM)...\033[0m"
sudo fstrim -va

echo -e "\033[1;32m✔ Optimización completa, David. Tu laptop quedó como recién formateada.\033[0m"
