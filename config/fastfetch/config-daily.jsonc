{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/pixel.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ❯ "
  },
  "modules": [
    { "type": "title", "format": "{1}" },
    "separator",
    { "type": "os", "key": "󰣇 OS", "keyColor": "cyan" },
    { "type": "kernel", "key": "󰒋 Kernel", "keyColor": "cyan" },
    { "type": "wm", "key": " WM", "keyColor": "cyan" },
    { "type": "terminal", "key": " Term", "keyColor": "cyan" },
    { "type": "packages", "key": "󰏖 Pkgs", "keyColor": "cyan" },
    { "type": "uptime", "key": "󱑂 Uptime", "keyColor": "cyan" },
    { "type": "memory", "key": "󰍛 RAM", "keyColor": "cyan" },
    "break"
  ]
}
