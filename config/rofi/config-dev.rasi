/**
 * Rofi - Modo Programación (Cyberpunk Cockpit Launcher)
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               " DEV";
    display-run:                " RUN";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10";
    icon-theme:                 "Tela-circle-dracula-dark";
}

* {
    font:                       "JetBrainsMono Nerd Font 10";
    background-color:           transparent;
    text-color:                 #f0f6fc;
}

window {
    width:                      460px;
    border:                     2px;
    border-color:               #00ffcc;
    border-radius:              10px;
    background-color:           rgba(10, 14, 20, 0.92);
    padding:                    12px;
    anchor:                     center;
    location:                   center;
}

mainbox {
    spacing:                    8px;
    children:                   [ inputbar, listview ];
}

inputbar {
    background-color:           rgba(16, 22, 34, 0.85);
    border-radius:              8px;
    border:                     1px;
    border-color:               rgba(0, 255, 204, 0.35);
    padding:                    7px 11px;
    spacing:                    8px;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 #00ffcc;
    font-size:                  11px;
    font-weight:                bold;
    vertical-align:             0.5;
}

entry {
    text-color:                 #f0f6fc;
    placeholder:                "Comando de desarrollo o app...";
    placeholder-color:          rgba(0, 255, 204, 0.30);
    vertical-align:             0.5;
}

listview {
    columns:                    1;
    lines:                      5;
    spacing:                    3px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    border:                     0px;
    padding:                    4px 0px 0px 0px;
}

element {
    padding:                    7px 11px;
    border-radius:              6px;
    spacing:                    10px;
}

element-icon {
    size:                       22px;
    vertical-align:             0.5;
}

element-text {
    text-color:                 #f0f6fc;
    vertical-align:             0.5;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 #f0f6fc;
}

element selected.normal {
    background-color:           rgba(0, 255, 204, 0.18);
    text-color:                 #00ffcc;
    border-radius:              6px;
    border:                     1px;
    border-color:               #00ffcc;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 #f0f6fc;
}
