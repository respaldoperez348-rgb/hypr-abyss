/**
 * Rofi - Modo Diario (Zen Glass Spotlight)
 * Sincronizado dinámicamente con la paleta de colores del wallpaper activo
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10.5";
    icon-theme:                 "Tela-circle-nord-dark";
}

@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    font:                       "JetBrainsMono Nerd Font 10.5";
    background-color:           transparent;
    text-color:                 @foreground;
}

window {
    width:                      480px;
    border:                     1.5px;
    border-color:               @selected-normal-background;
    border-radius:              18px;
    background-color:           rgba(12, 19, 27, 0.90);
    padding:                    14px;
    anchor:                     center;
    location:                   center;
}

mainbox {
    spacing:                    10px;
    children:                   [ inputbar, listview ];
}

inputbar {
    background-color:           rgba(255, 255, 255, 0.06);
    border-radius:              12px;
    border:                     1px;
    border-color:               rgba(255, 255, 255, 0.12);
    padding:                    8px 12px;
    spacing:                    10px;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 @selected-normal-background;
    font-size:                  12px;
    vertical-align:             0.5;
}

entry {
    text-color:                 @foreground;
    placeholder:                "Buscar aplicación o comando...";
    placeholder-color:          rgba(255, 255, 255, 0.35);
    vertical-align:             0.5;
}

listview {
    columns:                    1;
    lines:                      6;
    spacing:                    5px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    border:                     0px;
    padding:                    4px 0px 0px 0px;
}

element {
    padding:                    8px 12px;
    border-radius:              10px;
    spacing:                    12px;
}

element-icon {
    size:                       22px;
    vertical-align:             0.5;
}

element-text {
    text-color:                 @foreground;
    vertical-align:             0.5;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

element selected.normal {
    background-color:           @selected-normal-background;
    text-color:                 #ffffff;
    border-radius:              10px;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}
