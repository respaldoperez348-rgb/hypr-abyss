/**
 * Rofi - Modo Diario (Zen Glass Spotlight)
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10.5";
    icon-theme:                 "Tela-circle-nord-light";
}

* {
    font:                       "JetBrainsMono Nerd Font 10.5";
    background-color:           transparent;
    text-color:                 #24292f;
}

window {
    width:                      460px;
    border:                     1.5px;
    border-color:               rgba(88, 166, 255, 0.45);
    border-radius:              18px;
    background-color:           rgba(246, 248, 250, 0.92);
    padding:                    14px;
    anchor:                     center;
    location:                   center;
}

mainbox {
    spacing:                    10px;
    children:                   [ inputbar, listview ];
}

inputbar {
    background-color:           rgba(234, 238, 242, 0.85);
    border-radius:              12px;
    border:                     1px;
    border-color:               rgba(88, 166, 255, 0.25);
    padding:                    8px 12px;
    spacing:                    10px;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 #0969da;
    font-size:                  12px;
    vertical-align:             0.5;
}

entry {
    text-color:                 #1f2328;
    placeholder:                "Buscar aplicación o comando...";
    placeholder-color:          rgba(31, 35, 40, 0.45);
    vertical-align:             0.5;
}

listview {
    columns:                    1;
    lines:                      5;
    spacing:                    4px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    border:                     0px;
    padding:                    4px 0px 0px 0px;
}

element {
    padding:                    8px 12px;
    border-radius:              10px;
    spacing:                    12px;
}

element-icon {
    size:                       22px;
    vertical-align:             0.5;
}

element-text {
    text-color:                 #24292f;
    vertical-align:             0.5;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 #24292f;
}

element selected.normal {
    background-color:           rgba(9, 105, 218, 0.12);
    text-color:                 #0969da;
    border-radius:              10px;
    border:                     1px;
    border-color:               rgba(9, 105, 218, 0.35);
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 #24292f;
}
